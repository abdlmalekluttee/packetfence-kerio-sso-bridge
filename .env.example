# ---- HTTP Basic auth PacketFence presents to the JSON-RPC endpoint (POST /) ----
BRIDGE_USER=packetfence
BRIDGE_PASS=

# ---- HTTP Basic auth for the management GUI (browser login) ----
ADMIN_USER=admin
ADMIN_PASS=

# ---- Listener / TLS ----
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=9090
CERT_FILE=/certs/bridge.crt
KEY_FILE=/certs/bridge.key

# Use python3 configure.py to safely quote passwords (including $ and quotes).
# Missing, blank and old placeholder passwords are rejected at startup.
CONFIG_PATH=/data/kerios.json
STATE_PATH=/data/state.sqlite3
VERIFIED_TTL=30
RECONCILE_INTERVAL=60
FALLBACK_TTL=3600
# For a private reverse-proxy backend only:
ALLOW_HTTP=false
# PUBLIC_ORIGIN=https://sso.example.test
# BIND_ADDR=127.0.0.1
# HOST_PORT=9090

# Kerio firewalls are NOT configured here anymore -- add them in the GUI.
# (Stored in ./data/kerios.json so they survive restarts.)
